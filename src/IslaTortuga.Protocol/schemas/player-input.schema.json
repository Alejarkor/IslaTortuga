{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://islatortuga.local/protocol/player-input.schema.json",
  "title": "PlayerInputPayload",
  "type": "object",
  "required": ["moveX", "moveY"],
  "properties": {
    "moveX": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "moveY": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
