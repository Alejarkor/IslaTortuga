# Puerto local de la herramienta AssetEditor
PORT=4100

# Carpeta raíz de assets físicos (relativa a Tools/AssetEditor o absoluta)
ASSETS_ROOT=../../Server/GameAssets/server_assets

# URL de la GameApi interna
GAME_API_URL=http://localhost:3001

# Token admin para los endpoints internos (cabecera x-admin-token)
ASSET_ADMIN_TOKEN=1234
