{
  "name": "islat-asset-editor",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Herramienta local para gestionar assets, metadatos, sidecars y manifests del sistema de assets dinámicos de IslaT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
