{
  "name": "isla-tortuga",
  "version": "0.1.0",
  "private": true,
  "description": "Juego web multijugador 2D top-down pixel art de misterio, cooperación y sabotaje social.",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server start:dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "unrs-resolver"
    ]
  }
}
