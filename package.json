{
  "name": "isla-tortuga",
  "version": "0.1.0",
  "private": true,
  "description": "Juego web multijugador 2D top-down pixel art de misterio, cooperación y sabotaje social.",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:client": "pnpm --filter web-client dev",
    "dev:api": "pnpm --filter api-server start:dev",
    "dev:server": "pnpm --filter api-server start:dev",
    "dev:game-server": "dotnet run --project ./src/IslaTortuga.Server/IslaTortuga.Server.csproj",
    "dev:content-tool": "dotnet run --project ./src/IslaTortuga.ContentTool/IslaTortuga.ContentTool.csproj",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter api-server build",
    "build:game-server": "dotnet build ./src/IslaTortuga.Server/IslaTortuga.Server.csproj",
    "build:content-tool": "dotnet build ./src/IslaTortuga.ContentTool/IslaTortuga.ContentTool.csproj",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "unrs-resolver"
    ]
  }
}
