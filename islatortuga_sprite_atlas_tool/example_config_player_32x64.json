{
  "input_path": "Pixel_art_character_sprite_32x32.zip",
  "output_dir": "export_player",
  "asset_name": "player",
  "frame_width": 32,
  "frame_height": 64,
  "scale_mode": "fit",
  "anchor": "bottom_center",
  "alpha_threshold": 1,
  "inner_padding": 0,
  "atlas_padding": 2,
  "max_atlas_width": 2048,
  "export_normalized_frames": true,
  "export_preview_sheet": true,
  "include_rotations_as_poses": false,
  "allow_scale_up": false,
  "offset_x": 0,
  "offset_y": 0,
  "direction_aliases": {
    "south": "down",
    "north": "up",
    "east": "right",
    "west": "left",
    "south-east": "down_right",
    "south-west": "down_left",
    "north-east": "up_right",
    "north-west": "up_left",
    "down": "down",
    "up": "up",
    "right": "right",
    "left": "left"
  },
  "animation_alias_rules": [
    [
      "(?i).*idle.*",
      "idle"
    ],
    [
      "(?i).*breath.*",
      "idle"
    ],
    [
      "(?i).*walk.*",
      "walk"
    ],
    [
      "(?i).*run.*",
      "walk"
    ],
    [
      "(?i).*move.*",
      "walk"
    ],
    [
      "(?i)^animation.*",
      "walk"
    ]
  ],
  "animation_frame_rates": {
    "idle": 4,
    "walk": 8
  },
  "default_frame_rate": 6,
  "repeat": -1
}