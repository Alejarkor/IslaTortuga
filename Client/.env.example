# URL del WebServer (proxy en desarrollo apunta aquí).
VITE_WEB_SERVER_URL=http://localhost:3000

# Manifest del personaje (creado con la herramienta de assets).
# target_type debe ser uno permitido por la BD: global | scenario | scenario_set | game_mode | event
VITE_CHARACTER_MANIFEST_TARGET_TYPE=global
VITE_CHARACTER_MANIFEST_TARGET_ID=playerEditorPregame

# assetKeys de los GLB dentro del manifest (la herramienta deja usage=null,
# por eso el cliente identifica cuerpo y pelo por su assetKey).
VITE_CHARACTER_BODY_ASSET_KEY=models/IT_Character - Rigged
VITE_CHARACTER_HAIR_ASSET_KEY=models/Pelos
