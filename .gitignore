# ============================================================
# DOCKER / BASE DE DATOS
# ============================================================

# Backups reales de base de datos
**/Backups/*.sql
**/Backups/*.dump
**/Backups/*.backup
**/backups/*.sql
**/backups/*.dump
**/backups/*.backup

# Permitir mantener la carpeta vacía en repo
!**/Backups/.gitkeep
!**/backups/.gitkeep

# Volúmenes locales si alguna vez los montas como carpetas
**/postgres_data/
**/pgdata/
**/data/postgres/
**/docker-data/

# NO ignorar estructura de base de datos
!**/migrations/
!**/migrations/*.sql
!**/seeds/
!**/seeds/*.sql
!**/init/
!**/init/*.sql


