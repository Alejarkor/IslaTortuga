    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register · Jugador 1 (host)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gameApiUrl}}/internal/auth/register",
              "host": [
                "{{gameApiUrl}}"
              ],
              "path": [
                "internal",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{p1_username}}\",\n  \"email\": \"{{p1_email}}\",\n  \"password\": \"secret123\",\n  \"nickname\": \"{{p1_nickname}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Crea P1. Guarda p1_playerId. Usa username/email aleatorios para no colisionar."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s=Date.now();",
                  "pm.collectionVariables.set(\"p1_username\",\"ana_\"+s);",
                  "pm.collectionVariables.set(\"p1_email\",\"ana_\"+s+\"@test.com\");",
                  "pm.collectionVariables.set(\"p1_nickname\",\"Ana\"+s);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", function(){ pm.response.to.have.status(201); });",
                  "const j=pm.response.json();",
                  "pm.collectionVariables.set(\"p1_playerId\", j.profile.player_id);",
                  "pm.collectionVariables.set(\"p1_userId\", j.user.user_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register · Jugador 2",
          "request": {
