        {
          "name": "6) Lanzar partida",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gameApiUrl}}/internal/rooms/{{roomId}}/launch",
              "host": [
                "{{gameApiUrl}}"
              ],
              "path": [
                "internal",
                "rooms",
                "{{roomId}}",
                "launch"
              ]
            },
            "description": "Requiere Game Server (Unity) levantado: el GameApi llama a create-match."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function(){ pm.response.to.have.status(200); });",
                  "const j=pm.response.json();",
                  "pm.collectionVariables.set(\"matchId\", j.matchId);",
                  "pm.collectionVariables.set(\"gatewayPort\", j.gateway.port);",
                  "if(j.tickets&&j.tickets[0]) pm.collectionVariables.set(\"ticket1\", j.tickets[0].ticketId);",
                  "if(j.tickets&&j.tickets[1]) pm.collectionVariables.set(\"ticket2\", j.tickets[1].ticketId);",
                  "pm.test(\"un ticket por jugador\", ()=> pm.expect(j.tickets.length).to.eql(2));",
                  "pm.test(\"sala in_game\", ()=> pm.expect(j.room.state).to.eql(\"in_game\"));"
                ]
              }
            }
          ]
        },
